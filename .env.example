# Onchain Development Configuration
#
# Rename this file to `.env` when ready to query onchain networks.
# For local development with Anvil, no .env file is needed.

# Gateway URL
VITE_AMP_QUERY_URL=https://gateway.amp.staging.thegraph.com

# Auth token (generate with: pnpm amp auth token --duration "3 days")
VITE_AMP_QUERY_TOKEN=your_token_here

# Published raw dataset - uncomment one:
# VITE_AMP_RPC_DATASET=edgeandnode/ethereum_mainnet@0.0.1
# VITE_AMP_RPC_DATASET=edgeandnode/base_mainnet@0.0.1
# VITE_AMP_RPC_DATASET=edgeandnode/arbitrum_one@0.0.1

# Network - must match dataset above:
# VITE_AMP_NETWORK=ethereum-mainnet
# VITE_AMP_NETWORK=base-mainnet
# VITE_AMP_NETWORK=arbitrum-one
